<Window x:Class="ProcessInvestigator.InvestigateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Investigate Process" Height="620" Width="820"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            <ItemsControl x:Name="NotesList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF4E5" BorderBrush="#FFB300" BorderThickness="1"
                                CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                            <TextBlock Text="{Binding}" Foreground="#8A5A00" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="Export Report..." Style="{StaticResource ToolbarButton}"
                HorizontalAlignment="Left" Margin="0,12,0,0" Click="ExportButton_Click"/>

        <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" CornerRadius="8">
            <TabControl Background="Transparent" BorderThickness="0" Margin="4">
                <TabItem Header="Overview">
                    <StackPanel Margin="14">
                        <TextBlock x:Name="OverviewText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Parent Chain">
                    <ListBox x:Name="ParentChainList" FontFamily="Consolas" FontSize="13" BorderThickness="0" Margin="8"/>
                </TabItem>
                <TabItem Header="Loaded DLLs">
                    <DataGrid x:Name="ModulesGrid" Style="{StaticResource CleanDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="220"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding FileName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Services">
                    <DataGrid x:Name="ServicesGrid" Style="{StaticResource CleanDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="180"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                            <DataGridTextColumn Header="ServiceDll" Binding="{Binding ServiceDll}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Network">
                    <DataGrid x:Name="NetworkGrid" Style="{StaticResource CleanDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="55"/>
                            <DataGridTextColumn Header="Local" Binding="{Binding LocalAddress}" Width="120"/>
                            <DataGridTextColumn Header="Local Port" Binding="{Binding LocalPort}" Width="85"/>
                            <DataGridTextColumn Header="Remote" Binding="{Binding RemoteAddress}" Width="120"/>
                            <DataGridTextColumn Header="Remote Port" Binding="{Binding RemotePort}" Width="95"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</Window>
