<Window x:Class="ProcessInvestigator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Investigator" Height="700" Width="1080"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <DockPanel Margin="16">

        <!-- ===================== Header ===================== -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Process Investigator" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Live process monitor  ·  right-click any process to investigate"
                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ===================== Toolbar ===================== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="FilterBox" Style="{StaticResource SearchBox}"
                         TextChanged="FilterBox_TextChanged"/>
                <TextBlock x:Name="FilterHint" Text="Search by name or PID..."
                           Foreground="{StaticResource TextSecondary}" FontSize="13"
                           Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="6" Padding="12,6">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===================== Process grid (card surface) ===================== -->
        <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" CornerRadius="8" Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="14" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <DataGrid x:Name="ProcessGrid" Style="{StaticResource CleanDataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="True" SelectionMode="Single">
                <DataGrid.Columns>

                    <!-- Icon + Name -->
                    <DataGridTemplateColumn Header="Name" Width="240" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding IconSource}" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>

                    <!-- CPU heat bar -->
                    <DataGridTemplateColumn Header="CPU" Width="120" SortMemberPath="CpuPercent">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Border Background="#EEEEEE" Height="6" CornerRadius="3" Width="70" HorizontalAlignment="Left"/>
                                    <Border Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                            Background="{Binding CpuPercent, Converter={StaticResource CpuHeatColorConverter}}"
                                            Width="{Binding CpuPercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=70}"/>
                                    <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:N1}%}"
                                               Margin="80,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Memory" Binding="{Binding MemoryDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Parent PID" Binding="{Binding ParentPid}" Width="90"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding ExecutablePath}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Investigate..." Click="Investigate_Click" FontWeight="Bold"/>
                        <Separator/>
                        <MenuItem Header="Open File Location" Click="OpenFileLocation_Click"/>
                        <MenuItem Header="Copy Path" Click="CopyPath_Click"/>
                        <Separator/>
                        <MenuItem Header="End Process" Click="EndProcess_Click" Foreground="{StaticResource DangerRed}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
