<Application x:Class="ProcessInvestigator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProcessInvestigator.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:CpuHeatColorConverter x:Key="CpuHeatColorConverter"/>
            <conv:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
            <conv:BoolToWeightConverter x:Key="BoolToWeightConverter"/>
            <conv:RunningToBrushConverter x:Key="RunningToBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
